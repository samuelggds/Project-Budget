{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MG Orçamentos",
  "version": "1.1.1",
  "identifier": "com.samuel.mg-orcamento",
  "build": {
    "beforeDevCommand": "npm --prefix .. run dev -- --host 0.0.0.0",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix .. run build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MG Orçamentos",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://mgrefrigeracoes.com.br; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://mgrefrigeracoes.com.br/api/updates/latest"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3QjNDMzQ0RjI1QkVCNUQKUldSZDYxdnlSTU96UjNES2FjRXpydkdhMGlTZVl6NDBxUlYxRTc1SGEyZG9kQnlBdENocnhhWWUK"
    }
  }
}
