# Frontend - valores públicos
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_ADMIN_EMAIL=
VITE_API_URL=https://mgrefrigeracoes.com.br

# Vercel Functions - segredos, sem prefixo VITE_
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ADMIN_EMAIL=
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAIL_BUCKET=mgrefrigeracoes-mail-prod-900558045319-sa-east-1-an
SES_FROM_EMAIL=contato@mgrefrigeracoes.com.br
SES_FROM_NAME=MG Refrigerações

# Token GitHub fine-grained somente leitura, restrito ao repositório Project-Budget.
# É usado SOMENTE no servidor para servir atualizações do repositório privado.
GITHUB_RELEASES_TOKEN=

# Lambda inbox/feedback
# Nunca exponha esta chave em VITE_* ou no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Tauri - fornecido no ambiente de build / GitHub Actions, nunca no frontend.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
