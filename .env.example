# Frontend - valores publicos
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Segredo privado de no minimo 32 caracteres aleatorios para hash do OTP
ADMIN_MFA_PEPPER=
VITE_API_URL=https://mgrefrigeracoes.com.br

# Vercel Functions - segredos, sem prefixo VITE_
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ADMIN_EMAIL=

# AWS continua somente para recebimento de e-mail e download de anexos armazenados no S3.
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAIL_BUCKET=mgrefrigeracoes-mail-prod-900558045319-sa-east-1-an

# Envio de e-mail transacional via Resend.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM_EMAIL=contato@mgrefrigeracoes.com.br
MAIL_FROM_NAME=MG Refrigerações

# Token GitHub fine-grained somente leitura, restrito ao repositorio Project-Budget.
# E usado SOMENTE no servidor para servir atualizacoes do repositorio privado.
GITHUB_RELEASES_TOKEN=

# Lambda inbox/feedback AWS
# O valor abaixo NAO e uma credencial. Ele apenas aponta para o segredo no AWS Secrets Manager.
SUPABASE_SECRET_ID=mgrefrigeracoes/budget/supabase

# Tauri - fornecido no ambiente de build / GitHub Actions, nunca no frontend.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
